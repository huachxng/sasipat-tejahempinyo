---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ChapterHeader from '../components/ChapterHeader.astro';
import ChapterNext from '../components/ChapterNext.astro';
import Byline from '../components/Byline.astro';
import { getProfile } from '../lib/published.ts';
import { person } from '../lib/jsonld.ts';
import { PERSON, BYLINE } from '../site.config.ts';

const profile = await getProfile();
const { Content } = await render(profile);
const p = profile.data;

const nickname = p.nickname ?? PERSON.nickname;
const penName = p.penName ?? PERSON.penName;
const stanfordAlias = p.stanfordAlias ?? PERSON.stanfordAlias;
const quotedName = `${PERSON.firstName} "${nickname}" ${PERSON.lastName}`;

// "Now — senior year …" → "senior year …" (the block already carries the heading).
const now = p.now.map((s) => s.replace(/^now\s*[—–:-]\s*/i, '').trim()).filter(Boolean);
// "Stanford University (2026)" → name + detail; "()" from an unfilled template is dropped.
const education = p.education
  .map((s) => {
    const m = /^(.*?)\s*\((.*?)\)\s*$/.exec(s);
    return m ? { name: m[1].trim(), detail: m[2].trim() } : { name: s.trim(), detail: '' };
  })
  .filter((e) => e.name);
const description = p.headline ?? `About ${PERSON.displayName}: names, school, research, archery and what is happening now.`;
---
<Base title={`About — ${PERSON.displayName}`} {description} active="about" type="profile" image="/og/about.png" jsonLd={person(p)}>
  <ChapterHeader slug="about">
    <div class="about-byline"><Byline name={BYLINE.profile} kind="About" extra={p.location ?? PERSON.location} /></div>
  </ChapterHeader>

  <section class="about ruled">
    <div class="container about-grid">
      <div class="about-main">
        <section class="names-block" aria-labelledby="names-title">
          <h2 id="names-title" class="label">Names</h2>
          <dl class="names mono">
            <div class="names-row"><dt>Name</dt><dd>{quotedName}</dd></div>
            <div class="names-row"><dt>Writes as</dt><dd>{penName}</dd></div>
            <div class="names-row"><dt>Stanford Summer Session</dt><dd>attended as {stanfordAlias}</dd></div>
          </dl>
        </section>
        <div class="prose about-prose"><Content /></div>
      </div>

      <aside class="about-side">
        <div class="portrait">
          <div class="portrait-slot" aria-hidden="true"><span class="marker"></span></div>
          <p class="portrait-caption mono">{p.location ?? PERSON.location}{p.classOf && <> · Class of {p.classOf}</>}</p>
        </div>

        {now.length > 0 && (
          <section class="side-block" aria-labelledby="now-title">
            <h2 id="now-title" class="label">Now</h2>
            <ul class="now-list mono">{now.map((line) => <li><span class="marker" aria-hidden="true"></span><span>{line}</span></li>)}</ul>
          </section>
        )}

        {education.length > 0 && (
          <section class="side-block" aria-labelledby="edu-title">
            <h2 id="edu-title" class="label">Education</h2>
            <ol class="edu">
              {education.map((e, i) => (
                <li>
                  <span class="edu-num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="edu-body"><span class="edu-name">{e.name}</span>{e.detail && <span class="edu-detail mono">{e.detail}</span>}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        {p.skills.length > 0 && (
          <section class="side-block" aria-labelledby="skills-title">
            <h2 id="skills-title" class="label">Skills</h2>
            <ul class="chips">{p.skills.map((s) => <li class="chip">{s}</li>)}</ul>
          </section>
        )}

        {p.languages.length > 0 && (
          <section class="side-block" aria-labelledby="lang-title">
            <h2 id="lang-title" class="label">Languages</h2>
            <ul class="chips">{p.languages.map((s) => <li class="chip">{s}</li>)}</ul>
          </section>
        )}
      </aside>
    </div>
  </section>

  <ChapterNext current="about" />
</Base>

<style>
  .about-byline { margin-top: 0.75rem; }
  .about { padding-block: clamp(40px, 6vh, 88px) clamp(64px, 10vh, 160px); }
  .about-grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: var(--gutter); row-gap: clamp(48px, 8vh, 96px); }
  .about-main, .about-side { grid-column: 1 / -1; min-width: 0; }
  @media (min-width: 1024px) {
    .about-main { grid-column: 1 / span 7; }
    .about-side { grid-column: 9 / span 4; }
  }

  .label { margin: 0 0 1rem; }

  /* Names block: mono definition list with rules between rows */
  .names-block { margin-bottom: clamp(32px, 5vh, 56px); }
  .names { margin: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); font-size: var(--t-small); }
  .names-row { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 0.5rem var(--gutter); padding: 0.85rem 0; }
  .names-row + .names-row { border-top: 1px solid var(--rule); }
  .names dt { color: var(--fg-2); text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--t-label); padding-top: 0.15em; }
  .names dd { margin: 0; color: var(--fg); overflow-wrap: anywhere; }
  @media (max-width: 480px) { .names-row { grid-template-columns: 1fr; gap: 0.25rem; } }

  .about-prose { font-size: var(--t-body); }
  /* Workaround: base.css's `.prose p { margin-block: 0 }` outranks `.prose > * + *`, so paragraphs lose their gap.
     Proposed base.css fix is in docs/HANDOFF-pages.md; remove this rule once applied. */
  .about-prose > :global(* + *) { margin-top: 1.1em; }

  /* Portrait slot: no photograph exists yet; a ruled, empty frame keeps the column composed */
  .portrait { display: none; }
  @media (min-width: 1024px) { .portrait { display: block; margin-bottom: clamp(32px, 5vh, 56px); } }
  .portrait-slot { position: relative; aspect-ratio: 4 / 5; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule); }
  .portrait-slot .marker { position: absolute; top: -3px; left: 0; }
  .portrait-caption { margin: 0.75rem 0 0; font-size: var(--t-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-3); }

  .side-block + .side-block { margin-top: clamp(32px, 5vh, 56px); }
  .now-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; font-size: var(--t-small); color: var(--fg); }
  .now-list li { display: grid; grid-template-columns: 6px minmax(0, 1fr); gap: 0.75rem; align-items: start; }
  .now-list .marker { margin-top: 0.5em; }

  .edu { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .edu li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--gutter); padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
  .edu-num { font-size: var(--t-label); color: var(--fg-3); padding-top: 0.3em; }
  .edu-body { display: grid; gap: 0.2rem; }
  .edu-name { font-family: var(--font-display), sans-serif; font-weight: 600; letter-spacing: -0.01em; font-size: var(--t-body); line-height: 1.3; }
  .edu-detail { font-size: var(--t-label); color: var(--fg-2); letter-spacing: 0.04em; }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips .chip { cursor: default; }
</style>
