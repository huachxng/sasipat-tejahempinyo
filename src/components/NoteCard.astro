---
// One row in a note / essay / tag list. Renders an <li>; the parent supplies the <ol>/<ul>.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TagList from './TagList.astro';
interface Props {
  href: string;
  title: string;
  kind?: string; // "Note" | "Essay" | "Achievement"
  meta?: string; // mono line after the kind, e.g. "updated 2026-09-16"
  summary?: string;
  thai?: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  sortTitle?: string; // data-title for client-side sorting
  sortDate?: string; // data-date (ISO) for client-side sorting
  index?: number; // stagger index for reveal
}
const { href, title, kind, meta, summary, thai, tags, cover, coverAlt, sortTitle, sortDate, index } = Astro.props;
---
<li class:list={['note-card', { 'note-card--thumb': !!cover }]} data-title={sortTitle ?? title.toLowerCase()} data-date={sortDate} style={index !== undefined ? `--i:${Math.min(index, 6)}` : undefined}>
  <a class="note-card__link" href={href}>
    {cover && (
      <span class="note-card__thumb photo">
        <Image src={cover} alt={coverAlt ?? ''} width={480} height={300} widths={[320, 480, 640]} sizes="(min-width: 640px) 160px, calc(100vw - 32px)" loading="lazy" format="webp" quality={70} />
      </span>
    )}
    <span class="note-card__body">
      {(kind || meta) && (
        <span class="note-card__meta mono">
          {kind && <span class="note-card__kind">{kind}</span>}
          {kind && meta && <span aria-hidden="true"> · </span>}
          {meta}
        </span>
      )}
      <h3 class="note-card__title">{title}</h3>
      {thai && <span class="thai note-card__thai">{thai}</span>}
      {summary && <span class="note-card__summary">{summary}</span>}
    </span>
  </a>
  {tags && tags.length > 0 && <TagList tags={tags} class="note-card__tags" />}
</li>
<style>
  .note-card { border-bottom: 1px solid var(--rule); }
  .note-card__link { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem var(--gutter); padding: 1.25rem 0 1rem; color: var(--fg); }
  .note-card__link:hover { text-decoration: none; }
  .note-card__link:hover .note-card__title { color: var(--gold); }
  @media (min-width: 640px) { .note-card--thumb .note-card__link { grid-template-columns: 160px minmax(0, 1fr); align-items: start; } }
  .note-card__thumb { display: block; }
  .note-card__thumb img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; border: 1px solid var(--rule); }
  .note-card__body { display: block; min-width: 0; }
  .note-card__meta { display: block; font-size: 12px; color: var(--fg-2); letter-spacing: 0.02em; margin-bottom: 0.4rem; }
  .note-card__kind { color: var(--gold); text-transform: uppercase; letter-spacing: 0.06em; font-size: 11px; }
  .note-card__title { margin: 0; font-family: var(--font-display), sans-serif; font-weight: 600; font-size: var(--t-3); line-height: 1.2; letter-spacing: -0.02em; text-wrap: balance; overflow-wrap: anywhere; transition: color var(--d-micro) var(--ease-out-quint); }
  .note-card__thai { display: block; margin-top: 0.25rem; }
  .note-card__summary { display: block; margin-top: 0.4rem; color: var(--fg-2); font-size: var(--t-small); max-width: 68ch; text-wrap: pretty; }
  .note-card :global(.note-card__tags) { margin: 0 0 1.25rem; }
</style>
