---
// STUB — replaced by the achievements agent. Wraps an optimised image with the pixel-mosaic reveal.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; widths?: number[]; sizes?: string; class?: string; loading?: 'lazy' | 'eager'; aspect?: string }
const { src, alt, widths = [480, 960, 1440], sizes = '(min-width: 1024px) 50vw, 100vw', class: cls = '', loading = 'lazy', aspect } = Astro.props;
---
<div class:list={['mosaic photo', cls]} style={aspect ? `aspect-ratio:${aspect}` : undefined}><Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} quality={72} format="webp" /></div>
