---
// Interactive 2D map for /notes (shared renderer, mode '2d'). Props: focus?: string (graph node id like "notes/slug");
// `?focus=<id>` in the URL overrides it. The canvas is aria-hidden: the notes list on the page is the accessible equivalent.
import { getGraph } from '../lib/graph.ts';
interface Props { focus?: string }
const { focus } = Astro.props;
const g = getGraph();
const counts = { note: 0, post: 0, ach: 0, tag: 0 };
for (const n of g.nodes) counts[n.k]++;
const links = g.edges.filter((e) => e.k === 'link').length;
---
<div class="graph2d" data-graph2d data-focus={focus}>
  <div class="g2-bar">
    <fieldset class="g2-filters">
      <legend class="sr-only">Show on the map</legend>
      <label><input type="checkbox" checked data-kind="note" /> Notes</label>
      <label><input type="checkbox" checked data-kind="post" /> Blog</label>
      <label><input type="checkbox" checked data-kind="ach" /> Achievements</label>
      <label><input type="checkbox" checked data-kind="tag" /> Tag links</label>
    </fieldset>
    <label class="g2-search">
      <span class="sr-only">Highlight titles containing</span>
      <input type="search" placeholder="Highlight a title…" autocomplete="off" data-g2-search />
    </label>
  </div>
  <div class="g2-stage" data-g2-stage>
    <canvas aria-hidden="true" data-g2-canvas></canvas>
    <div class="hg-label" hidden data-hg-chip>
      <span class="hg-kind" data-hg-kind></span>
      <span class="hg-title" data-hg-title></span>
      <span class="hg-date" data-hg-date hidden></span>
      <span class="hg-open">Open →</span>
    </div>
  </div>
  <div class="g2-foot">
    <p class="g2-summary">{counts.note} notes, {counts.post} essays and {counts.ach} achievements joined by {links} wikilinks and {counts.tag} tag hubs. The list below is the accessible equivalent.</p>
    <ul class="g2-legend" aria-hidden="true">
      <li><i class="sw sw-note"></i>Note / essay</li>
      <li><i class="sw sw-ach"></i>Achievement</li>
      <li><i class="sw sw-tag"></i>Tag hub</li>
      <li><i class="sw sw-gold"></i>Selected</li>
    </ul>
  </div>
</div>
<script src="../scripts/graph-2d.ts"></script>
<style>
  .graph2d { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .g2-bar { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center; justify-content: space-between; padding: 0.75rem 0; font-family: var(--font-mono), monospace; font-size: var(--t-small); }
  .g2-filters { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0; padding: 0; border: 0; min-width: 0; }
  .g2-filters label { display: inline-flex; align-items: center; gap: 0.45em; color: var(--fg-2); cursor: pointer; }
  .g2-filters label:hover { color: var(--fg); }
  .g2-filters input { accent-color: var(--gold); margin: 0; width: 14px; height: 14px; }
  .g2-search input { font: inherit; color: var(--fg); background: var(--bg-2); border: 1px solid var(--rule-strong); padding: 0.4em 0.7em; width: min(100%, 240px); }
  .g2-search input:focus { border-color: var(--gold); outline: none; }
  .g2-search input::placeholder { color: var(--fg-3); }
  .g2-stage { position: relative; height: 60vh; min-height: 320px; background: var(--bg); border-top: 1px solid var(--rule); }
  .g2-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; }
  .g2-stage canvas.is-pointer { cursor: pointer; }
  .g2-foot { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; align-items: baseline; padding: 0.75rem 0; }
  .g2-summary { margin: 0; font-family: var(--font-mono), monospace; font-size: var(--t-label); color: var(--fg-2); max-width: 60ch; }
  .g2-legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; list-style: none; margin: 0; padding: 0; font-family: var(--font-mono), monospace; font-size: var(--t-label); text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-2); }
  .g2-legend li { display: inline-flex; align-items: center; gap: 0.5em; }
  .sw { width: 8px; height: 8px; background: var(--fg); }
  .sw-ach { background: var(--fg-2); }
  .sw-tag { background: none; border: 1.5px solid var(--gold-dim); }
  .sw-gold { background: var(--gold); }
  /* label chip (same markup as the hero) */
  .hg-label { position: absolute; z-index: 2; pointer-events: none; display: grid; gap: 0.2rem; max-width: 260px; padding: 0.5rem 0.7rem; background: var(--bg-2); border: 1px solid var(--rule-strong); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45); }
  .hg-kind { font: 500 var(--t-label) / 1.2 var(--font-mono), monospace; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  .hg-title { font: 500 16px / 1.25 var(--font-display), sans-serif; letter-spacing: -0.01em; color: var(--fg); }
  .hg-date { font: 400 var(--t-label) / 1.2 var(--font-mono), monospace; color: var(--fg-2); }
  .hg-open { display: none; font: 500 var(--t-label) / 1.2 var(--font-mono), monospace; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold); margin-top: 0.2rem; }
  .hg-label.is-tap .hg-open { display: block; }
  .hg-label[hidden] { display: none; }
  @media (max-width: 767px) { .g2-stage { height: 40vh; min-height: 260px; } }
</style>
