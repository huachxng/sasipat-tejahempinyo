---
interface Props { name: string; kind: string; date?: string; extra?: string }
const { name, kind, date, extra } = Astro.props;
---
<p class="byline mono">{kind}{date && <> · {date}</>} · by {name}{extra && <> · {extra}</>}</p>
<style>.byline { font-size: 12px; color: var(--fg-2); margin: 0; letter-spacing: 0.02em; }</style>
