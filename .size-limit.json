[
  {
    "name": "Client JS — every chunk in dist/_astro (upper bound for the home page; check-dist measures the exact set index.html loads)",
    "path": [
      "dist/_astro/*.js"
    ],
    "limit": "60 KB",
    "gzip": true
  },
  {
    "name": "Hero WebGL renderer (lazy)",
    "path": [
      "dist/_astro/graph-gl.*.js"
    ],
    "limit": "15 KB",
    "gzip": true
  },
  {
    "name": "CSS — every stylesheet in dist/_astro",
    "path": [
      "dist/_astro/*.css"
    ],
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "Home page HTML (inline scripts, poster SVG and styles included)",
    "path": [
      "dist/index.html"
    ],
    "limit": "60 KB",
    "gzip": true
  },
  {
    "name": "BIS chart script (the chunk /research loads)",
    "path": [
      "dist/_astro/BisChart*.js"
    ],
    "limit": "8 KB",
    "gzip": true
  }
]
